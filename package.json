{
  "name": "aiflow",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "path": "^0.12.7",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.aiflow.app",
    "productName": "AiFlow",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "db.js",
      "index.html",
      "styles.css",
      "AiFlow_logo.ico",
      ".env.defaults",
      ".env.example",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "AiFlow_logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "AiFlow_logo.ico",
      "uninstallerIcon": "AiFlow_logo.ico",
      "installerHeaderIcon": "AiFlow_logo.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}